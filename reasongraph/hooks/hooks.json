{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "reasongraph hook stop" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "reasongraph hook session-end" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "reasongraph hook pre-tool-use" }
        ]
      }
    ]
  }
}
